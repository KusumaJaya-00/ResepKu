<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="8dp"
    android:elevation="2dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgResep"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:background="@drawable/bg_image_placeholder"
            android:clipToOutline="true"
            android:contentDescription="@string/desc_gambar_resep"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_card_recipe"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNama"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:minLines="1"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="12sp"
                    app:autoSizeMaxTextSize="18sp"
                    app:autoSizeStepGranularity="2sp"
                    android:textColor="@color/stone_900"
                    tools:text="Nama Resep" />

                <TextView
                    android:id="@+id/chipKategori"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_chip_outline"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:textColor="@color/orange_600"
                    android:textSize="14sp"
                    tools:text="kategori" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnFavorit"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@color/transparent"
                android:contentDescription="@string/action_favorite_add"
                android:padding="12dp"
                android:src="@drawable/ic_menu_favorit_outline"
                app:tint="@color/stone_900" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
